{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "test -n \"$VERCEL_GIT_PREVIOUS_SHA\" && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- . ':(exclude)supabase/migrations/**'",
  "crons": [
    {
      "path": "/api/cron/settlements",
      "schedule": "17 3 * * *"
    }
  ]
}
